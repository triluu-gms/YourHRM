# Copy to infra/docker/.env to override defaults. LOCAL DEVELOPMENT ONLY.
# .env is git-ignored; never commit real credentials.
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev
# password given to every yhrm_* login role (yhrm_migrator, yhrm_app_core, ...)
YHRM_APP_PASSWORD=yhrm_dev
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev
VALKEY_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
OPENBAO_PORT=8200
OPENBAO_DEV_TOKEN=root_dev
