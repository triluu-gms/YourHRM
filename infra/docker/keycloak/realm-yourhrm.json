{
  "realm": "yourhrm",
  "enabled": true,
  "displayName": "YourHRM (local development)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "defaultSignatureAlgorithm": "RS256",
  "clients": [
    {
      "clientId": "yourhrm-web",
      "name": "YourHRM web (dev BFF)",
      "description": "Local development only: the Vite dev BFF uses the direct access grant. Production uses hrm-bff with Authorization Code + PKCE (ADR-0014).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:5173/*" },
      "protocolMappers": [
        {
          "name": "tenant_id (dev tenant)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "01900000-0000-7000-8000-000000000001",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "access.tokenResponse.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "018f0000-0000-7000-8000-0000000000ad",
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Tenant",
      "lastName": "Owner",
      "email": "admin@demo.local",
      "credentials": [{ "type": "password", "value": "admin_dev", "temporary": false }]
    },
    {
      "id": "018f0000-0000-7000-8000-0000000000e5",
      "username": "employee",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Nhân viên",
      "lastName": "Demo",
      "email": "employee@demo.local",
      "credentials": [{ "type": "password", "value": "employee_dev", "temporary": false }]
    }
  ]
}
