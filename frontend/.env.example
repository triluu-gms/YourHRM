# Dev server only (dev/bff-plugin.ts). Never commit a filled-in .env.
# Backend API the dev BFF proxies /api/** to
YHRM_API_URL=http://localhost:8080
# Keycloak realm used by the dev login form (Resource Owner Password grant on a confidential/public client)
YHRM_KEYCLOAK_ISSUER=http://localhost:8180/realms/yourhrm
YHRM_KEYCLOAK_CLIENT_ID=yourhrm-web
#YHRM_KEYCLOAK_CLIENT_SECRET=
# Alternative: skip Keycloak and attach this access token to every proxied request
#YHRM_DEV_TOKEN=eyJ...
# SPA: "form" shows the dev login form, "redirect" sends the browser to /bff/login (real hrm-bff)
VITE_BFF_LOGIN_MODE=form
